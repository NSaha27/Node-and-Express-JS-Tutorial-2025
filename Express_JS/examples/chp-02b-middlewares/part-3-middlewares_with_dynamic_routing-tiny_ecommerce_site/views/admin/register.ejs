<%- include("../header.ejs") %>
          <li><a href="/admin/account">Account</a></li>
          <li><a href="/admin/login">Login</a></li>
        </ul>
      </nav>
    </header>
    <main>
      <% if(message){ %>
          <div class="message"><%= message %></div>
      <% } %>
      <h1>Admin Registration</h1>
      <div>
        <form action="/admin/register" method="post">
          <div><label for="id">Admin ID</label><br><input type="text" name="id" id="id"></div>
          <div><label for="name">Name</label><br><input type="text" name="name" id="name"></div>
          <div><label for="govnDocType">Govn. Document Type</label><br><input type="text" name="govnDocType" id="govnDocType"></div>
          <div><label for="govnDocID">Govn. Document ID</label><br><input type="text" name="govnDocID" id="govnDocID"></div>
          <div><label for="address">Address</label><br><textarea name="address" id="address" rows="10" cols="24"></textarea></div>
          <div><label for="phone">Phone</label><br><input type="text" name="phone" id="phone"></div>
          <div><label for="email">Email ID</label><br><input type="email" name="email" id="email"></div>
          <div><label for="password">Password</label><br><input type="password" name="password" id="password"></div>
          <div><label for="confirmpassword">Confirm Password</label><br><input type="password" name="confirmpassword" id="confirmpassword"></div>
          <div><button type="submit">Register</button></div>
        </form>
        <p>OR</p>
        <p>already registered? Login <a href="/admin/login">here</a></p>
      </div>
    <%- include("../footer.ejs") %>
