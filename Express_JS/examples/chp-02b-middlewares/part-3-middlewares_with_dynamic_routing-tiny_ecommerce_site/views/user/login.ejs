<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tiny Ecommerce</title>
    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <header>
      <nav>
        <div class="logo">
          <h2><a href="/">Tiny-Ecommerce</a></h2>
        </div>
        <ul class="menu">
          <li><a href="/">Home</a></li>
          <li>
            <a href="#">Products ▾</a>
            <ul class="dropdown">
              <li><a href="/products/men">Men</a></li>
              <li><a href="/products/women">Women</a></li>
              <li><a href="/products/kids">Kids</a></li>
            </ul>
          </li>
          <li><a href="/user/account">Account</a></li>
          <li><a href="/user/login">Login</a></li>
        </ul>
      </nav>
    </header>
    <main>
      <% if(message){ %>
          <div class="message"><%= message %></div>
      <% } %>
      <h1>Admin Login</h1>
      <div>
        <form action="/user/login" method="post">
          <div><label for="id">User ID</label><br><input type="text" name="id" id="id"></div>
          <div><label for="password">Password</label><br><input type="password" name="password" id="password"></div>
          <div><button type="submit">Login</button></div>
        </form>
        <p>OR</p>
        <p>not yet registered? Register <a href="/user/register">here</a></p>
      </div>
    </main>
  </body>
</html>
